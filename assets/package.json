{
  "name": "@romainmillan/mobile-navigation-bundle",
  "version": "0.1.2",
  "private": true,
  "description": "iOS 26 \"liquid glass\" mobile navigation: Stimulus controllers and styles of romainmillan/mobile-navigation-bundle",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "keywords": [
    "symfony-ux"
  ],
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./controllers/*": {
      "types": "./dist/types/controllers/*.d.ts",
      "import": "./dist/controllers/*.js"
    },
    "./styles": {
      "sass": "./styles/index.scss"
    },
    "./styles/*": "./styles/*",
    "./dist/mobile-navigation.css": "./dist/mobile-navigation.css",
    "./package.json": "./package.json",
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist",
    "styles"
  ],
  "scripts": {
    "build": "node build.mjs && sass styles/index.scss dist/mobile-navigation.css --no-source-map && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "symfony": {
    "controllers": {
      "confirm-sheet": {
        "main": "dist/controllers/confirm_sheet_controller.js",
        "webpackMode": "eager",
        "fetch": "eager",
        "enabled": true
      },
      "confirm-submit": {
        "main": "dist/controllers/confirm_submit_controller.js",
        "webpackMode": "eager",
        "fetch": "eager",
        "enabled": true
      },
      "emit-event": {
        "main": "dist/controllers/emit_event_controller.js",
        "webpackMode": "eager",
        "fetch": "eager",
        "enabled": true
      },
      "filter-bar": {
        "main": "dist/controllers/filter_bar_controller.js",
        "webpackMode": "eager",
        "fetch": "eager",
        "enabled": true
      },
      "gesture": {
        "main": "dist/controllers/gesture_controller.js",
        "webpackMode": "eager",
        "fetch": "eager",
        "enabled": true
      },
      "large-title": {
        "main": "dist/controllers/large_title_controller.js",
        "webpackMode": "eager",
        "fetch": "eager",
        "enabled": true
      },
      "list": {
        "main": "dist/controllers/list_controller.js",
        "webpackMode": "eager",
        "fetch": "eager",
        "enabled": true
      },
      "navigate": {
        "main": "dist/controllers/navigate_controller.js",
        "webpackMode": "eager",
        "fetch": "eager",
        "enabled": true
      },
      "sheet": {
        "main": "dist/controllers/sheet_controller.js",
        "webpackMode": "eager",
        "fetch": "eager",
        "enabled": true
      },
      "swipe-actions": {
        "main": "dist/controllers/swipe_actions_controller.js",
        "webpackMode": "eager",
        "fetch": "eager",
        "enabled": true
      },
      "swipe-back": {
        "main": "dist/controllers/swipe_back_controller.js",
        "webpackMode": "eager",
        "fetch": "eager",
        "enabled": true
      },
      "tab-bar": {
        "main": "dist/controllers/tab_bar_controller.js",
        "webpackMode": "eager",
        "fetch": "eager",
        "enabled": true
      }
    },
    "importmap": {
      "@hotwired/stimulus": "^3.0.0"
    }
  },
  "peerDependencies": {
    "@hotwired/stimulus": "^3.0.0",
    "@hotwired/turbo": "^7.3 || ^8.0"
  },
  "peerDependenciesMeta": {
    "@hotwired/turbo": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@types/node": "^22",
    "jsdom": "^30.1.1",
    "sass": "^1.93",
    "typescript": "^5.9",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f"
}
