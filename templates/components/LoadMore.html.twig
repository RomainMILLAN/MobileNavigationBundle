{% trans_default_domain 'rm_mnb' %}
{#
    "Load more": the next page loads into this frame, without leaving the list. The
    response must contain a <turbo-frame> with the same id (the rows of the next page, and
    its own "Load more" if any remain). Requires Turbo. Props: see the LoadMore class.
#}
<turbo-frame id="{{ frameId }}" target="_top">
    <a href="{{ href }}" class="rm-mnb-load-more {{ attributes.render('class') }}" data-turbo-frame="{{ frameId }}" {{ attributes }}>
        {{ 'list.load_more'|trans }}
    </a>
</turbo-frame>
