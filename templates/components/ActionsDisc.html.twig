{% trans_default_domain 'rm_mnb' %}
{#
    The "…" glass disc of the top row: it opens the action sheet of the page (window
    command <sheet>:toggle), like the "…" menu of iOS. The icon block replaces the three
    dots (variable: icon). Props: see the ActionsDisc class.
#}
<button type="button" class="rm-mnb-glass-disc {{ attributes.render('class') }}"
        aria-label="{{ label ?? 'actions.more'|trans }}"
        aria-controls="{{ sheet }}" aria-haspopup="dialog" aria-expanded="false"
        {{ attributes.defaults(stimulus_controller(rm_mnb_controller('emit-event'), { name: sheet ~ ':toggle' })|stimulus_action(rm_mnb_controller('emit-event'), 'emit')) }}>
    <span class="rm-mnb-icon-slot">{% block icon %}
        {%- if icon %}<i class="{{ icon }}" aria-hidden="true"></i>{% else %}<span class="rm-mnb-icon rm-mnb-icon--more" aria-hidden="true"></span>{% endif -%}
    {% endblock %}</span>
</button>
